# =============================================================================
# Aurum — OSRS GE Terminal · Environment Configuration
# Copy to .env and customize before running
# =============================================================================

# Server port (local dev / Docker)
PORT=8000
LOG_LEVEL=INFO

# SQLite WAL database file path
DATABASE_PATH=./data/osrs_terminal.db

# OSRS Wiki Real-Time Prices API (descriptive User-Agent is REQUIRED by Wiki policy)
WIKI_USER_AGENT="aurum-osrs/2.0 - your-contact-here"

# Authentication (leave APP_PASSWORD blank for passwordless local dev; ALWAYS set on VPS!)
APP_PASSWORD=
SESSION_SECRET=change-me-to-random-32-byte-hex

# RuneLite Dink Webhook secret token (generate with: openssl rand -hex 24)
DINK_WEBHOOK_TOKEN=change-me-dink-token

# Optional Discord Webhook URL (can also be configured live in the Settings UI)
DISCORD_WEBHOOK_URL=

# Default starting bankroll settings (editable in UI)
DEFAULT_CASH_STACK=25000000
DEFAULT_GE_SLOTS=8
DEFAULT_MEMBERS=true

# Hetzner Production Domain (used only by deploy/docker-compose.prod.yml + Caddy)
DOMAIN=flip.yourdomain.com
